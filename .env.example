# ============================================================================
# SPATHODEA R4 FASTLAB — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================================

# --- OpenAI ---
OPENAI_API_KEY=

# --- Google Gemini ---
GEMINI_API_KEY=

# --- Local LLM (Ollama) ---
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1

# --- AWS (optional, for direct S3 upload) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET_NAME=

# --- Pipeline Settings ---
# FASTLAB_LOG_LEVEL=INFO
# FASTLAB_SEED=42
